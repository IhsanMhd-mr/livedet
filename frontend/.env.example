# Frontend Environment Configuration
# Copy this file to .env.local and update values as needed

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API Base URL
# For development: http://localhost:8000
# For production: https://api.example.com or http://production-backend:8000
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# DEBUG SETTINGS
# ============================================================================

# Enable debug logs in console (true/false)
VITE_DEBUG=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable result history (true/false)
VITE_ENABLE_HISTORY=true

# Enable result export (true/false)
VITE_ENABLE_EXPORT=true

# ============================================================================
# NOTES
# ============================================================================

# This file is used by Vite and should be committed to version control
# To override values, create a .env.local file (not committed) with your changes
# Environment variables must start with VITE_ to be accessible in the frontend
