# ============================================
# live-detection-ML2 PROJECT - CONFIGURATION TEMPLATE
# Copy this file to .env and customize for your device
# ============================================

# BACKEND CONFIGURATION
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# MODEL CONFIGURATION
# Options: yolov10n, yolov10s, yolov10m, yolov10l, yolov10x
MODEL_TYPE=yolov10m
MODEL_PATH=./runs/detect/pothole_detector2/weights/best.pt
CONFIDENCE_THRESHOLD=0.5

# INFERENCE CONFIGURATION
# Device: cpu, 0 (GPU 0), 1 (GPU 1), etc.
DEVICE=cpu
# Image size for inference
IMAGE_SIZE=640
# Max detections per image
MAX_DETECTIONS=100

# TRAINING CONFIGURATION
TRAIN_EPOCHS=50
TRAIN_BATCH_SIZE=4
TRAIN_DEVICE=cpu
TRAIN_PATIENCE=10

# DATASET PATHS
DATA_YAML_PATH=./data/data.yaml
DATASET_ROOT=./dataset

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:5000
VITE_API_PROXY_PATH=/api

# LOGGING
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# SEVERITY CALCULATION STANDARDS
# Options: conservative, standard, aggressive
SEVERITY_STANDARD=standard

# ROAD TYPE CONFIGURATION
ROAD_TYPE=urban_street
# Options: highway, local_road, urban_street, parking_lot, rural

# DEPTH ESTIMATION
ESTIMATE_DEPTH=true
DEPTH_UNIT=cm

# PERFORMANCE OPTIMIZATION
NUM_WORKERS=2
CACHE_ENABLED=false
